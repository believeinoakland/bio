{
  "permissions": {
    "allow": [
      "Bash(node */tools/proc.mjs *)",
      "Bash(node tools/proc.mjs *)",
      "Bash(node */checks/run.mjs *)",
      "Bash(node --test *)",
      "Bash(git fetch *)",
      "Bash(git pull --no-rebase *)",
      "Bash(git merge *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin HEAD:*)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git ls-remote *)",
      "mcp__claude-code-remote__create_session",
      "mcp__claude-code-remote__send_message",
      "mcp__claude-code-remote__send_later",
      "mcp__claude-code-remote__archive_session",
      "mcp__claude-code-remote__get_session",
      "mcp__claude-code-remote__list_events",
      "mcp__claude-code-remote__subscribe_pr_activity",
      "mcp__claude-code-remote__unsubscribe_pr_activity",
      "mcp__claude-code-remote__delete_trigger",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__add_issue_comment",
      "mcp__github__issue_write",
      "mcp__github__pull_request_review_write",
      "mcp__github__update_pull_request_branch",
      "mcp__github__merge_pull_request",
      "mcp__github__pull_request_read",
      "mcp__github__get_job_logs"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --mirror *)",
      "Bash(git push origin --delete *)",
      "Bash(git push origin :*)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin main)",
      "Bash(git push -u origin main)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(git stash drop *)",
      "Bash(git rebase *)",
      "Bash(git commit --amend *)",
      "Bash(git tag *)",
      "Bash(git branch -D *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "4"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -d \"/home/user/neoprocess/.git\" ]; then { [ \"$(git -C \"/home/user/neoprocess\" rev-parse --abbrev-ref HEAD)\" = main ] && [ -z \"$(git -C \"/home/user/neoprocess\" status --porcelain --untracked-files=no)\" ] && git -C \"/home/user/neoprocess\" fetch -q origin +refs/heads/main:refs/remotes/origin/main && git -C \"/home/user/neoprocess\" merge -q --ff-only origin/main; } || echo \"neoProcess: could not bring /home/user/neoprocess to the tip of main\" >&2; else git clone -q --branch main https://github.com/neobobkrause/neoprocess \"/home/user/neoprocess\" || echo \"neoProcess: could not clone neobobkrause/neoprocess to /home/user/neoprocess\" >&2; fi"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/user/neoprocess/tools/hooks.mjs\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/user/neoprocess/tools/hooks.mjs\" post"
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/user/neoprocess/tools/hooks.mjs\" display",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/user/neoprocess/tools/hooks.mjs\" stop"
          },
          {
            "type": "command",
            "command": "node \"/home/user/neoprocess/tools/hooks.mjs\" evidence",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
