{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Edit(.env)",
      "Write(.env)",
      "Edit(.env.local)",
      "Write(.env.local)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(node scripts/deploy.mjs:*)",
      "Bash(node bio-plane/scripts/deploy.mjs:*)",
      "Bash(npx wrangler deploy:*)"
    ]
  }
}
