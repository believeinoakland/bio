{
  "name": "bio-plane",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/battery.mjs",
    "test:livefire": "node test/livefire.test.mjs",
    "build": "npm run embed:sign && node scripts/build-plane.mjs",
    "deploy": "node scripts/deploy.mjs",
    "dev": "wrangler dev",
    "test:migrate": "node test/migrate.test.mjs",
    "test:browse": "node test/browse.test.mjs",
    "test:hygiene": "node scripts/battery.mjs hygiene",
    "test:purge": "node test/purge.test.mjs",
    "test:installer": "node test/installer.test.mjs",
    "test:members": "node test/members.test.mjs",
    "test:ratify": "node test/ratify.test.mjs",
    "embed:sign": "node scripts/embed-signpage.mjs",
    "test:profile": "node test/profile.test.mjs",
    "test:framework-digest-audit": "node test/framework-digest-audit.test.mjs",
    "test:reading-wire": "node test/reading-wire.test.mjs",
    "test:subresources": "node test/subresources.test.mjs",
    "test:pdfstructure": "node test/pdfstructure.test.mjs",
    "test:fence": "node test/fence.test.mjs",
    "test:search": "node test/search.test.mjs",
    "test:grounds": "node test/grounds.test.mjs",
    "test:publish": "node test/publish.test.mjs",
    "test:reevaluation": "node test/reevaluation.test.mjs",
    "test:publishedcase": "node test/publishedcase.test.mjs",
    "test:queue": "node test/queue.test.mjs",
    "test:queue-state": "node test/queue-state.test.mjs",
    "test:queue-conditions": "node test/queue-conditions.test.mjs",
    "test:multifinding": "node test/multifinding.test.mjs",
    "test:battery": "node scripts/battery.mjs",
    "test:coverage": "node scripts/coverage.mjs --strict"
  },
  "devDependencies": {
    "miniflare": "^4.20260722.0",
    "wrangler": "^4.114.0",
    "esbuild": "^0.25.0"
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_TOKEN": {
        "description": "Full control, including deleting everything. Generate a long random value and store it in a password manager. **Do not reuse a password.**"
      },
      "MEMBER_TOKEN": {
        "description": "Day-to-day access for working group members. Generate a *different* long random value."
      },
      "PROBE_TOKEN": {
        "description": "Testing only. Can read, but can only change a scratch area. Safe to share. Generate a *third* value."
      }
    }
  },
  "version": "0.79.0"
}
