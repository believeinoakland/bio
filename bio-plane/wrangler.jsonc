{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bio-plane",
  // The account this Worker belongs to, PINNED, for the same reason as the
  // installer: wrangler otherwise uses whatever OAuth session the machine
  // carries. The RELEASE path does not depend on this (scripts/deploy.mjs takes
  // the account from CF_ACCT and talks to the REST API directly), but
  // `wrangler dev` does, and a dev session against the wrong account is a
  // confusing way to lose an afternoon.
  "account_id": "20b533579290b9b93168345edd3b7f72",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "vars": { "VERSION": "0.55.0" },

  // The store. new_sqlite_classes is required: SQLite-backed Durable Objects
  // are a different storage backend from the legacy key-value one and cannot
  // be switched after the fact.
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Store"] }
  ],

  // Captures, split by fence. Bindings, not access keys: nothing outside
  // Cloudflare signs an R2 request, so there is no key to leak or rotate.
  //
  // CAPTURES  working corpus. Everything lands here on intake, ratified or
  //           not. Private. Backs the working-scope AI Search instance.
  // PUBLISHED ratified material only, written by the publisher as the act of
  //           ratification. Public. Backs the published-scope instance.
  //
  // The fence is the bucket boundary, so a published-scope query cannot reach
  // unratified material by any bug in any predicate: that corpus has never
  // seen it. Scope is the caller-facing parameter; two buckets is what makes
  // the parameter safe rather than advisory.
  "r2_buckets": [
    { "binding": "CAPTURES",  "bucket_name": "bio-captures" },
    { "binding": "PUBLISHED", "bucket_name": "bio-published" }
  ],

  // The fleet (I6). pdf-worker is a SEPARATE Worker holding unpdf/pdf.js; the
  // plane calls it over this service binding for Tier-2 text extraction on the
  // residue Tier 1 cannot decode, and reshapes NOTHING — the member returns the
  // record's own I2 shape. The binding is OPTIONAL at runtime: op=pdfstructure
  // checks `env.PDF_WORKER` and falls back to in-plane Tier 1 when it is absent,
  // so an instance that has not yet installed the fleet (D-115, DIST's) still
  // reads PDFs — it just does Tier 1 only. DIST owns actually deploying the
  // member and teaching the installer to install the fleet; a slot-less area
  // cannot deploy a second Worker.
  "services": [
    { "binding": "PDF_WORKER", "service": "pdf-worker" }
  ],

  "observability": { "enabled": true }
}
