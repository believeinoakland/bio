{
  "r2_buckets": [
    {
      "binding": "CAPTURES",
      "bucket": "captures"
    }
  ],
  "crons": [
    "17 4 * * *"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SCANNER",
        "class_name": "FileScanner"
      },
      {
        "name": "RENDERER",
        "class_name": "SafeViewRenderer"
      }
    ],
    "migrations": [
      {
        "tag": "v1",
        "classes": [
          "FileScanner",
          "SafeViewRenderer"
        ]
      }
    ]
  }
}
