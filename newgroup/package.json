{
  "name": "bio-newgroup-wizard",
  "private": true,
  "type": "module",
  "scripts": {
    "embed": "node scripts/embed-release.mjs",
    "build": "npm run embed && esbuild src/index.mjs --bundle --format=esm --platform=neutral --outfile=dist/newgroup.bundled.mjs",
    "test": "npm run embed && node test/wizard.test.mjs",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "wrangler": "^4.114.0"
  }
}
