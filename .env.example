# Copy to .env and fill in. .env is gitignored and is carried into worktrees.
# NEVER commit real values: tokens.mjs denylists anything published in the repo
# and treats it as NOT SET, so committing a token revokes it.

# Cloudflare, for deploying (DIST) and for reading a script back to verify it
CF_TOKEN=
CF_ACCT=20b533579290b9b93168345edd3b7f72
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=20b533579290b9b93168345edd3b7f72

# The instance this session verifies against. One per area: do NOT share a
# scratch namespace between concurrent sessions, they will purge each other.
BIO_INSTANCE=biosmoke7
BIO_MEMBER_TOKEN=
BIO_ADMIN_TOKEN=

# Release signing. DIST only. Blank for every other area.
BIO_RELEASE_SEED=
BIO_RATIFY_SEED=

# DS-3 — the account cascade's THIRD level: the Claude account this INSTANCE
# falls back to when no member and no project account covers a run (FL-6
# resolves member -> project -> instance and records which level paid).
#
# This is an ANTHROPIC credential the instance presents to Claude, and it
# decides who PAYS. It is NOT the `ai` credential (`aik-...`), which is BIO's
# own and travels the other way — an agent presents that one TO the plane.
#
# SETTING IT IS A MEMBER ACT (D-199.3). There is deliberately no op, no store
# row and no setter: `deploy.mjs` carries this value into the instance as a
# Worker secret when it is present here, and nothing an agent can call reaches
# it. Leave it blank and the cascade answers a stated UNAVAILABLE rather than
# failing silently.
#
# Never commit a real value: publication IS revocation here — tokens.mjs hashes
# it into the denylist and the cascade then reports
# INSTANCE_ACCOUNT_REVOKED_BY_PUBLICATION instead of spending it.
INSTANCE_CLAUDE_TOKEN=

