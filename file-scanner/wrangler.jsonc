{
  "$schema": "../bio-plane/node_modules/wrangler/config-schema.json",
  "name": "file-scanner",

  // PINNED: the repository decides the account, never the machine's wrangler session (CLAUDE.md).
  "account_id": "20b533579290b9b93168345edd3b7f72",

  // R10: the committed bundle of src/worker.mjs deploys (built by `npm run build`, guarded by bundler R24).
  "main": "dist/file-scanner.bundled.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // The release's version site (bundler R12), as every member's.
  "vars": { "VERSION": "0.87.0" },

  // Reachable only through the plane's FILE_SCANNER service binding: no public address of its own.
  "workers_dev": false,
  "preview_urls": false,

  // The Worker's own limits, stated in its bundle too (src/limits.mjs; installer R39): the paid plan's CPU ceiling,
  // which the mirror's streaming and a batch's reads stay within.
  "limits": { "cpu_ms": 300000 },

  // R6: every ten minutes: finishes an open mirror request, resumes a stopped run, otherwise mirrors once a day.
  "triggers": { "crons": ["*/10 * * * *"] },

  // The team's bucket: captures are read (never written, R11); the mirror and reputation lists are written under
  // clamav/ and reputation/. The installer names the team's bucket here.
  "r2_buckets": [
    { "binding": "CAPTURES", "bucket_name": "bio-captures" }
  ],

  // R10: the two containers. Each image is named by the release's registry rule, as agent-runner's is: the
  // repository fleet-member.json's class states (Docker Hub, docker.io/civicsmith), @sha256:<64 hex>, the digest the
  // release published, the same reference as the marker's. Cloudflare Containers pull public Docker Hub images by
  // digest with no credential, and do not pull from GitHub's registry (the GitHub copy of each image stays published but is
  // not named here). Neither container has internet (src/worker.mjs, enableInternet false; R12).
  "containers": [
    {
      "class_name": "FileScanner",
      "image": "docker.io/civicsmith/file-scanner-scanner@sha256:e3e266ba1b7070e76fcf50e89634a39df515fa41d2498e84651c6e191eca36af",
      "instance_type": "standard-1",
      "max_instances": 3
    },
    {
      "class_name": "SafeViewRenderer",
      "image": "docker.io/civicsmith/file-scanner-renderer@sha256:6f71d5799e8d24b1d9eb168f5b64a01fb0e084942672c2502b6346311777e35b",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "SCANNER", "class_name": "FileScanner" },
      { "name": "RENDERER", "class_name": "SafeViewRenderer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FileScanner", "SafeViewRenderer"] }
  ],

  // SECURITY_VPC (a Workers VPC binding) is absent by default; the installer adds it for a tool whose descriptor
  // states reach "tunnel" (R10, R21).

  "observability": { "enabled": true }
}
