# file-scanner's ClamAV image (R3, R4, R6, R10, R14), the `FileScanner` class's container.
# Build (the release; never in a session, K1898): docker build --platform linux/amd64 -f Dockerfile.scanner -t <repository>-scanner:<version> file-scanner
# The image is then named only by its digest, which the release writes into fleet-member.json and wrangler.jsonc (R10).
# The base is pinned by digest: node:22-bookworm-slim, its linux/amd64 manifest as read on 2026-10-06 (as agent-runner's).
# Its packages, pinned, are those packages-scanner.json states (bundler R27), from a dated Debian snapshot.
FROM node:22-bookworm-slim@sha256:efd0ab5780c2d9ab1f0f869571a00d5edb17793bff4cce4a2792e3eb0ffc7562
RUN rm -f /etc/apt/sources.list.d/debian.sources \
 && echo "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20261006T000000Z bookworm main" > /etc/apt/sources.list.d/snapshot.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      clamav=1.4.3+dfsg-1~deb12u2 clamav-base=1.4.3+dfsg-1~deb12u2 \
      clamav-freshclam=1.4.3+dfsg-1~deb12u2 libclamav12=1.4.3+dfsg-1~deb12u2 \
 && rm -rf /var/lib/apt/lists/* /var/lib/clamav/* \
 && mkdir -p /var/lib/file-scanner/sigs && chown -R node:node /var/lib/file-scanner
# freshclam is never run: the image has no network (R12); the only signatures are the mirror's, handed in by the Worker (R4).
ENV NODE_ENV=production PORT=8080 FILE_SCANNER_SIGS=/var/lib/file-scanner/sigs
WORKDIR /app
COPY container/common.mjs container/scanner.mjs ./container/
COPY src/limits.mjs ./src/
USER node
EXPOSE 8080
CMD ["node", "container/scanner.mjs"]
