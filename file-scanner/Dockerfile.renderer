# file-scanner's safe-view image (R7, R10, R14), the `SafeViewRenderer` class's container.
# Build (the release; never in a session, K1898): docker build --platform linux/amd64 -f Dockerfile.renderer -t <repository>-renderer:<version> file-scanner
# The image is then named only by its digest, which the release writes into fleet-member.json and wrangler.jsonc (R10).
# The base is pinned by digest: node:22-bookworm-slim, its linux/amd64 manifest as read on 2026-10-06 (as agent-runner's).
# Its packages, pinned, are those packages-renderer.json states (bundler R27), from dated Debian snapshots.
FROM node:22-bookworm-slim@sha256:efd0ab5780c2d9ab1f0f869571a00d5edb17793bff4cce4a2792e3eb0ffc7562
RUN rm -f /etc/apt/sources.list.d/debian.sources \
 && echo "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20261006T000000Z bookworm main" > /etc/apt/sources.list.d/snapshot.list \
 && echo "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20261006T000000Z bookworm-security main" >> /etc/apt/sources.list.d/snapshot.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      libreoffice-core=4:7.4.7-1+deb12u14 libreoffice-writer=4:7.4.7-1+deb12u14 libreoffice-impress=4:7.4.7-1+deb12u14 \
      poppler-utils=22.12.0-2+deb12u3 fonts-dejavu-core=2.37-6 fonts-liberation2=2.1.5-1 \
 && rm -rf /var/lib/apt/lists/*
# LibreOffice runs headless with a profile made and removed per request; macros never run and nothing reaches the network (R12).
ENV NODE_ENV=production PORT=8080
WORKDIR /app
COPY container/common.mjs container/renderer.mjs ./container/
COPY src/limits.mjs ./src/
USER node
EXPOSE 8080
CMD ["node", "container/renderer.mjs"]
